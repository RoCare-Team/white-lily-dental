# Copy to .env.local and fill in real values. .env.local is git-ignored.

# MongoDB Atlas connection string — Atlas → Connect → Drivers
MONGODB_URI="mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="whitelilydental"

